{
  "name": "@dachengge/dsh-skill-catalog",
  "version": "0.1.1",
  "description": "DSH 技能总览插件：设置页「技能总览」面板 + DSH 端口上的完整看板（/skills）。实时扫描 ~/.agents/skills，展示用途/触发词/边界/正文骨架/关联模型/验证级别。",
  "license": "Apache-2.0",
  "author": "成哥聊AI (赵成成)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IdeoAllen/dsh-plugin.git",
    "directory": "packages/skill-catalog"
  },
  "homepage": "https://github.com/IdeoAllen/dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/IdeoAllen/dsh-plugin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skill",
    "catalog",
    "harness"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh.plugin.json": "./dsh.plugin.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19"
  }
}
