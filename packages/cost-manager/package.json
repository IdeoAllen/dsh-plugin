{
  "name": "@chengge/dsh-cost-manager",
  "version": "0.1.0",
  "description": "DSH 成本管理插件：余额/费用/模型能力/任务会话统计 + 防死（硬地板与欠费切换建议）。适配用户绑定的模型，自动扫描会话用量。",
  "license": "Apache-2.0",
  "author": "成哥聊AI (赵成成)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IdeoAllen/dsh-plugin.git",
    "directory": "packages/cost-manager"
  },
  "homepage": "https://github.com/IdeoAllen/dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/IdeoAllen/dsh-plugin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cost",
    "billing",
    "token-usage",
    "budget"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh.plugin.json": "./dsh.plugin.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19"
  }
}
