# 统一换行符为 LF 存库。
# 不设的话 Windows 检出会写回 CRLF，导致跨平台 diff 满屏都是行尾变化。
* text=auto eol=lf

# 二进制：不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# 生成产物（由 build-html.mjs + sync-core.mjs 产出），diff 无意义
packages/skill-catalog/lib/core/web/index.html -diff linguist-generated
packages/session-manager/lib/core/web/index.html -diff linguist-generated
